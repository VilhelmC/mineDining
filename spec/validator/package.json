{
	"name": "@minedining/recipe-spec",
	"version": "0.1.0",
	"description": "Validator and instruction generator for the mineDining recipe DAG spec",
	"private": true,
	"type": "module",
	"scripts": {
		"gen-types": "json2ts -i ../schema/recipe.schema.json -o src/types.ts --style.useTabs && node gen-schema.mjs",
		"build": "tsc -p .",
		"test": "npm run build && node --test \"dist/test/*.test.js\"",
		"validate": "node dist/src/cli.js",
		"prepare": "tsc -p ."
	},
	"dependencies": {
		"ajv": "8.20.0"
	},
	"devDependencies": {
		"@types/node": "22.20.5",
		"json-schema-to-typescript": "16.0.0",
		"typescript": "5.9.3"
	},
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		}
	},
	"files": [
		"dist/src"
	]
}
